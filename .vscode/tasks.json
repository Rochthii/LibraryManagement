{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (g++ MinGW64)",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "-Ilib/SFML/include",
                "-g",
                "main.cpp",
                "UI/GiaoDienSFML.cpp",
                "UI/ManHinhMenuChinh.cpp",
                "UI/ManHinhQuanLySach.cpp",
                "UI/ManHinhThongTin.cpp",
                "UI/TienIchGiaoDien.cpp",
                "data/KiemTraDuLieu.cpp",
                "data/QuanLySach.cpp",
                "data/ThaoTacFile.cpp",
                "data/NhapLieu.cpp",
                "utils/ThongBao.cpp",
                "utils/NgayThang.cpp",
                "utils/XuLyChuoi.cpp",
                "-I.",
                "-Llib/SFML/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio",
                "-lsfml-network",
                "-lgdi32",
                "-luser32",
                "-lole32",
                "-loleaut32",
                "-lcomdlg32",
                "-luuid",
                "-o",
                "${workspaceFolder}/bin/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile project using MinGW-w64 g++ and link SFML"
        },
        {
            "label": "Run GUI (integrated)",
            "type": "shell",
            "command": "${workspaceFolder}\\bin\\main.exe",
            "dependsOn": "Build (g++ MinGW64)",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-I${workspaceFolder}/lib/SFML/include"
            ],
            "options": {
                "cwd": "C:/msys64/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}