{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build VietnameseUtils Object",
			"type": "shell",
			"command": "C:/mingw64/bin/g++.exe",
			"args": [
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-Wno-unused-parameter",
				"-finput-charset=UTF-8",
				"-fexec-charset=UTF-8",
				"-g",
				"-c",
				"src/VietnameseUtils.cpp",
				"-o",
				"bin/VietnameseUtils.o"
			],
			"group": "build",
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build testDauSach (minimal)",
			"type": "shell",
			"command": "C:/mingw64/bin/g++.exe",
			"args": [
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-Wno-unused-parameter",
				"-finput-charset=UTF-8",
				"-fexec-charset=UTF-8",
				"-g",
				"src/Main.cpp",
				"src/DauSach.cpp",
				"src/DanhMucSach.cpp",
				"src/InputUtils.cpp",
				"bin/VietnameseUtils.o",
				"-o",
				"bin/main.exe"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"Build VietnameseUtils Object"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Run testDauSach",
			"type": "shell",
			"command": "chcp 65001; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; .\\bin\\main.exe",
			"dependsOn": [
				"Build testDauSach (minimal)"
			]
		},
		{
			"label": "Run main.exe (UTF-8)",
			"type": "shell",
			"command": "chcp 65001; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; .\\bin\\main.exe",
			"isBackground": false,
			"group": "build",
			"dependsOn": [
				"Build testDauSach (minimal)"
			]
		},
		{
			"label": "build: gen_dausach",
			"type": "shell",
			"command": "C:/mingw64/bin/g++.exe",
			"args": [
				"-std=gnu++17",
				"-O2",
				"tools/gen_dausach.cpp",
				"-o",
				"tools/gen_dausach.exe"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}