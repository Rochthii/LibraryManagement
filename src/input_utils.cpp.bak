static const int SO_LAN_THU_TOI_DA = 5;

// Cờ cấu hình hành vi ISBN
static bool g_lenientFile = true;     
static bool g_warnOnFixFile = false;  
static bool g_lenientInput = false;

// Khai báo trước các hàm cần thiết
static inline void seedNgauNhienMotLan();
