// =============================================================================
// KIỂM TRA KÝ TỰ
// =============================================================================

// Kiểm tra loại ký tự ASCII (gộp tất cả các hàm kiểm tra ký tự)
inline bool laKyTuSo(char c)           { return c >= '0' && c <= '9'; }
inline bool laKyTuChuHoa(char c)       { return c >= 'A' && c <= 'Z'; }  
inline bool laKyTuChuThuong(char c)    { return c >= 'a' && c <= 'z'; }
inline bool laKyTuChuCai(char c)       { return laKyTuChuHoa(c) || laKyTuChuThuong(c); }
inline bool laKyTuKhoangTrang(char c)  { return c==' ' || c=='\t' || c=='\n' || c=='\r' || c=='\f' || c=='\v'; }

// =============================================================================
// THÔNG BÁO VÀ HIỂN THỊ (Gộp helper functions và thông báo)
// =============================================================================

enum LoaiThongBao { LOI, THONG_TIN, CANH_BAO };

// In thông báo với định dạng chuẩn (hàm tổng quát)
static void inThongBaoChung(std::ostream& out, const std::string& msg, LoaiThongBao loai){
    const char* tienTo[] = {"Lỗi: ", "Thông tin: ", "Cảnh báo: "};
    out << tienTo[loai] << msg << "\n";
}

// Helper để format thông báo lỗi với số dòng  
inline std::string thongBaoLoi(int soDong, const std::string& noiDung) {
    return "Dòng " + std::to_string(soDong) + ": " + noiDung;
}

inline std::string thongBaoLoiDMS(int soDong, const std::string& noiDung) {
    return "Dòng DMS " + std::to_string(soDong) + ": " + noiDung;
}

// Thông báo số lần thử còn lại khi nhập sai
static inline void thongBaoSoLanThuConLai(int soLanDaThu, std::ostream& out){
    if(soLanDaThu < SO_LAN_THU_TOI_DA)
        inThongBaoChung(out, "Còn " + std::to_string(SO_LAN_THU_TOI_DA - soLanDaThu) + " lần thử.", THONG_TIN);
}

// Wrapper công khai cho thông báo
void baoLoi(std::ostream& out, const std::string& msg){ inThongBaoChung(out, msg, LOI); }
void baoThongTin(std::ostream& out, const std::string& msg){ inThongBaoChung(out, msg, THONG_TIN); }
void baoCanhBao(std::ostream& out, const std::string& msg){ inThongBaoChung(out, msg, CANH_BAO); }

// =============================================================================
// KIỂM TRA VÀ VALIDATION
// =============================================================================

// Báo lỗi khi giá trị ngoài phạm vi cho phép
static inline bool thongBaoLoiNgoaiPhamVi(std::ostream& out, const std::string& tenTruong, long long giaTriMin, long long giaTriMax){
    inThongBaoChung(out, tenTruong + " phải trong [" + std::to_string(giaTriMin) + ", " + std::to_string(giaTriMax) + "]!", LOI);
    return false;
}

// Kiểm tra điều kiện và báo lỗi nếu không thỏa mãn
template<typename T>
static inline bool kiemTraDieuKienVaBaoLoi(bool dieuKienDung, const std::string& thongBaoLoi, std::ostream& out){
    if(!dieuKienDung) { inThongBaoChung(out, thongBaoLoi, LOI); return false; }
    return true;
}

// Kiểm tra dữ liệu đầu vào với validator tùy chỉnh
template<typename HamKiemTra>
static bool kiemTraDuLieuDauVao(const std::string& duLieu, const std::string& tenTruong, HamKiemTra hamKiemTra, std::ostream& out){
    if(!KiemTraChuoiRong(duLieu, tenTruong, out)) return false;
    return hamKiemTra(duLieu, out);
}

// =============================================================================
// CHUYỂN ĐỔI KÝ TỰ (Gộp các hàm chuyển đổi hoa/thường)
// =============================================================================

// Chuyển đổi hoa/thường cho ký tự ASCII (hàm tổng quát)
inline char chuyenDoiKyTu(char c, bool thanhHoa) { 
    return thanhHoa ? (laKyTuChuThuong(c) ? char(c - 'a' + 'A') : c)
                   : (laKyTuChuHoa(c) ? char(c - 'A' + 'a') : c);
}

// Wrapper functions cho dễ sử dụng
inline char chuyenThanhHoa(char c)    { return chuyenDoiKyTu(c, true); }
inline char chuyenThanhThuong(char c) { return chuyenDoiKyTu(c, false); }

// =============================================================================
// XỬ LÝ CHUỖI CƠ BẢN
// =============================================================================

// Loại bỏ khoảng trắng đầu và cuối chuỗi
static std::string loaiBoKhoangTrangDauCuoi(const std::string& s){
    size_t trai = 0, phai = s.size();
    while(trai < phai && laKyTuKhoangTrang(s[trai])) ++trai;
    while(phai > trai && laKyTuKhoangTrang(s[phai-1])) --phai;
    return s.substr(trai, phai - trai);
}

// Kiểm tra chuỗi rỗng hoặc chỉ có khoảng trắng
static bool laChuoiRongHoacChiKhoangTrang(const std::string& s){
    for(char c: s){
        if(!laKyTuKhoangTrang(c)) return false;
    }
    return true;
}

// So sánh độ dài chuỗi với phạm vi cho phép
static int soSanhDoDaiChuoi(const std::string& s, size_t minL, size_t maxL){
    if(s.length() < minL) return -1;  
    if(s.length() > maxL) return 1;    
    return 0;                         
}

// Lấy chỉ các ký tự số từ chuỗi
static std::string layChiCacKyTuSo(const std::string& s){
    std::string ketQua; ketQua.reserve(s.size());
    for(char c: s) if(laKyTuSo(c)) ketQua.push_back(c);
    return ketQua;
}


// =============================================================================
// XỬ LÝ UNICODE VÀ TIẾNG VIỆT
// =============================================================================
static void appendCodePointUtf8(std::string& out, uint32_t cp){
    if(cp <= 0x7F){ out.push_back(static_cast<char>(cp)); return; }
    if(cp <= 0x7FF){
        out.push_back(static_cast<char>(0xC0 | (cp >> 6)));
        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
        return;
    }
    if(cp <= 0xFFFF){
        out.push_back(static_cast<char>(0xE0 | (cp >> 12)));
        out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
        return;
    }
    out.push_back(static_cast<char>(0xF0 | (cp >> 18)));
    out.push_back(static_cast<char>(0x80 | ((cp >> 12) & 0x3F)));
    out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
    out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
}

// Kiểm tra cp là chữ cái Latin (bao gồm các khối có dấu dùng cho tiếng Việt)
static inline bool laChuCaiLatinUnicode(uint32_t cp){
    // Latin-1 (trừ ký hiệu toán): À..Ö (0xC0..0xD6), Ø..ö (0xD8..0xF6), ø..ÿ (0xF8..0xFF)
    if((cp >= 0xC0 && cp <= 0xD6) || (cp >= 0xD8 && cp <= 0xF6) || (cp >= 0xF8 && cp <= 0xFF)) return true;
    // Latin Extended-A/B 0100..024F
    if(cp >= 0x0100 && cp <= 0x024F) return true;
    // Latin Extended Additional 1E00..1EFF
    if(cp >= 0x1E00 && cp <= 0x1EFF) return true;
    return false;
}

// Đọc 1 codepoint UTF-8 từ chuỗi; trả về U+FFFD nếu lỗi, cập nhật i
static uint32_t docCodePointUtf8(const std::string& s, size_t& i){
    unsigned char c = static_cast<unsigned char>(s[i]);
    if(c < 0x80){ // ASCII
        ++i; return c;
    }
    // 2-byte
    if((c & 0xE0) == 0xC0){
        if(i+1 >= s.size()) { ++i; return 0xFFFD; }
        unsigned char c1 = static_cast<unsigned char>(s[i+1]);
        if((c1 & 0xC0) != 0x80){ i += 2; return 0xFFFD; }
        uint32_t cp = ((c & 0x1F) << 6) | (c1 & 0x3F);
        i += 2; return cp;
    }
    // 3-byte
    if((c & 0xF0) == 0xE0){
        if(i+2 >= s.size()) { ++i; return 0xFFFD; }
        unsigned char c1 = static_cast<unsigned char>(s[i+1]);
        unsigned char c2 = static_cast<unsigned char>(s[i+2]);
        if(((c1 & 0xC0) != 0x80) || ((c2 & 0xC0) != 0x80)){ i += 3; return 0xFFFD; }
        uint32_t cp = ((c & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F);
        i += 3; return cp;
    }
    // 4-byte (không cần cho tiếng Việt, nhưng xử lý cho đủ)
    if((c & 0xF8) == 0xF0){
        if(i+3 >= s.size()) { ++i; return 0xFFFD; }
        unsigned char c1 = static_cast<unsigned char>(s[i+1]);
        unsigned char c2 = static_cast<unsigned char>(s[i+2]);
        unsigned char c3 = static_cast<unsigned char>(s[i+3]);
        if(((c1 & 0xC0) != 0x80) || ((c2 & 0xC0) != 0x80) || ((c3 & 0xC0) != 0x80)){ i += 4; return 0xFFFD; }
        uint32_t cp = ((c & 0x07) << 18) | ((c1 & 0x3F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F);
        i += 4; return cp;
    }
    // byte không hợp lệ
    ++i; return 0xFFFD;
}

struct CapUnicode { uint32_t lower; uint32_t upper; };
static const CapUnicode CAP_VI[] = {
    // a A + dấu
    {0x00E0,0x00C0},{0x00E1,0x00C1},{0x1EA3,0x1EA2},{0x00E3,0x00C3},{0x1EA1,0x1EA0},
    // ă Ă + dấu
    {0x0103,0x0102},{0x1EB1,0x1EB0},{0x1EAF,0x1EAE},{0x1EB3,0x1EB2},{0x1EB5,0x1EB4},{0x1EB7,0x1EB6},
    // â Â + dấu
    {0x00E2,0x00C2},{0x1EA7,0x1EA6},{0x1EA5,0x1EA4},{0x1EA9,0x1EA8},{0x1EAB,0x1EAA},{0x1EAD,0x1EAC},
    // e E + dấu
    {0x00E8,0x00C8},{0x00E9,0x00C9},{0x1EBB,0x1EBA},{0x1EBD,0x1EBC},{0x1EB9,0x1EB8},
    // ê Ê + dấu
    {0x00EA,0x00CA},{0x1EC1,0x1EC0},{0x1EBF,0x1EBE},{0x1EC3,0x1EC2},{0x1EC5,0x1EC4},{0x1EC7,0x1EC6},
    // i I + dấu
    {0x00EC,0x00CC},{0x00ED,0x00CD},{0x1EC9,0x1EC8},{0x0129,0x0128},{0x1ECB,0x1ECA},
    // o O + dấu
    {0x00F2,0x00D2},{0x00F3,0x00D3},{0x1ECF,0x1ECE},{0x00F5,0x00D5},{0x1ECD,0x1ECC},
    // ô Ô + dấu
    {0x00F4,0x00D4},{0x1ED3,0x1ED2},{0x1ED1,0x1ED0},{0x1ED5,0x1ED4},{0x1ED7,0x1ED6},{0x1ED9,0x1ED8},
    // ơ Ơ + dấu
    {0x01A1,0x01A0},{0x1EDD,0x1EDC},{0x1EDB,0x1EDA},{0x1EDF,0x1EDE},{0x1EE1,0x1EE0},{0x1EE3,0x1EE2},
    // u U + dấu
    {0x00F9,0x00D9},{0x00FA,0x00DA},{0x1EE7,0x1EE6},{0x0169,0x0168},{0x1EE5,0x1EE4},
    // ư Ư + dấu
    {0x01B0,0x01AF},{0x1EEB,0x1EEA},{0x1EE9,0x1EE8},{0x1EED,0x1EEC},{0x1EEF,0x1EEE},{0x1EF1,0x1EF0},
    // y Y + dấu
    {0x1EF3,0x1EF2},{0x00FD,0x00DD},{0x1EF7,0x1EF6},{0x1EF9,0x1EF8},{0x1EF5,0x1EF4},
    // đ Đ
    {0x0111,0x0110}
};

// ============ HÀM CHUYỂN ĐỔI HOA/THƯỜNG TIẾNG VIỆT TỔNG HỢP ============
static uint32_t chuyenDoiCaseTiengViet(uint32_t cp, bool thanhHoa){
    // Xử lý ASCII trước (nhanh hơn)
    if(laKyTuChuThuong(cp)) return thanhHoa ? (cp - 'a' + 'A') : cp;
    if(laKyTuChuHoa(cp)) return thanhHoa ? cp : (cp - 'A' + 'a');
    
    // Xử lý ký tự tiếng Việt Unicode
    for(const auto& p : CAP_VI){ 
        if(cp == p.lower) return thanhHoa ? p.upper : p.lower;
        if(cp == p.upper) return thanhHoa ? p.upper : p.lower;
    }
    return cp;
}

// Wrapper tái sử dụng hàm chung (tên tiếng Việt rõ nghĩa)
static uint32_t chuyenThanhHoaTiengViet(uint32_t cp){ return chuyenDoiCaseTiengViet(cp, true); }
static uint32_t chuyenThanhThuongTiengViet(uint32_t cp){ return chuyenDoiCaseTiengViet(cp, false); }

// Viết hoa chữ đầu mỗi từ theo chuẩn tiếng Việt (Unicode-aware)
static std::string tieuDeHoaTiengViet(const std::string& s){
    std::string out; out.reserve(s.size());
    bool newWord = true;
    size_t i = 0;
    while(i < s.size()){
        size_t start = i; // lưu lại vị trí bắt đầu codepoint để có thể chép nguyên xi khi cần
        uint32_t cp = docCodePointUtf8(s, i);
        if(cp <= 0x7F){
            char c = static_cast<char>(cp);
            if(c == ' '){ out.push_back(' '); newWord = true; }
            else if(laKyTuChuCai(c)){
                uint32_t up = newWord ? chuyenThanhHoaTiengViet(static_cast<uint32_t>(c)) : chuyenThanhThuongTiengViet(static_cast<uint32_t>(c));
                appendCodePointUtf8(out, up);
                newWord = false;
            } else {
                // Ký tự khác: chép lại, reset từ nếu là khoảng trắng (đã xử lý ở trên)
                out.push_back(c);
                newWord = false;
            }
        } else {
            // Unicode letter
            if(laChuCaiLatinUnicode(cp)){
                uint32_t mapped = newWord ? chuyenThanhHoaTiengViet(cp) : chuyenThanhThuongTiengViet(cp);
                appendCodePointUtf8(out, mapped);
                newWord = false;
            } else {
                // Không phải chữ Latin -> chép nguyên xi
                out.append(s, start, i - start);
                newWord = false;
            }
        }
    }
    return out;
}

 

// Kiểm tra cp là chữ cái Latin (bao gồm các khối có dấu dùng cho tiếng Việt)
// Cho phép giữ "chữ cái" unicode và tối đa 1 khoảng trắng giữa các từ; trim hai đầu
// Bảo toàn byte gốc của ký tự unicode bằng cách nối lại substring đã đọc
static std::string locChuCaiUnicodeKhoang1(const std::string& s){
    std::string out; out.reserve(s.size());
    bool truocSpace = true; // để tránh space đầu
    size_t i = 0;
    while(i < s.size()){
        size_t start = i;
        uint32_t cp = docCodePointUtf8(s, i);
        if(cp <= 0x7F){
            char c = static_cast<char>(cp);
            if(laKyTuChuCai(c)){
                out.push_back(c); truocSpace = false;
            } else if(c == ' ' && !truocSpace){
                out.push_back(' '); truocSpace = true;
            } // else bỏ
        } else {
            if(laChuCaiLatinUnicode(cp)){
                out.append(s, start, i - start); // giữ nguyên byte unicode
                truocSpace = false;
            } else {
                // Ký tự unicode không thuộc Latin: bỏ qua; nếu muốn giữ các dấu kết hợp, có thể mở rộng ở đây
            }
        }
    }
    return CatKhoangTrang(out);
}


// Chuẩn hóa riêng cho nhập "phái":
// - bỏ khoảng trắng
// - ascii -> chữ thường
// - mọi biến thể 'ư'/'Ư' (kèm dấng) -> 'u'
static std::string chuanHoaPhaiForCompare(const std::string& s){
    std::string out; out.reserve(s.size());
    size_t i = 0;
    while(i < s.size()){
        uint32_t cp = docCodePointUtf8(s, i);
        if(cp <= 0x7F){
            char c = static_cast<char>(cp);
            if(!laKyTuKhoangTrang(c)){
                c = chuyenThanhThuong(c);
                out.push_back(c);
            }
            continue;
        }
        // Map tất cả biến thể 'Ư'/'ư' (có/không dấu) -> 'u'
        if(cp == 0x01AF || cp == 0x01B0 ||
           cp == 0x1EE8 || cp == 0x1EE9 || cp == 0x1EEA || cp == 0x1EEB ||
           cp == 0x1EEC || cp == 0x1EED || cp == 0x1EEE || cp == 0x1EEF ||
           cp == 0x1EF0 || cp == 0x1EF1){ out.push_back('u'); continue; }
    }
    return out;
}

// Kiểm tra độ dài [min, max], in lỗi và trả về true nếu hợp lệ
static bool hopLeTheoDoDai(const std::string& s, size_t minL, size_t maxL, std::ostream& out, bool themTienToSauLoc){
    int cmp = soSanhDoDaiChuoi(s, minL, maxL);
    if(cmp == 0) return true;
    const char* tienTo = themTienToSauLoc ? "Sau lọc " : "";
    if(cmp < 0) baoLoi(out, std::string(tienTo) + "quá ngắn (>= " + to_string(minL) + ")!");
    else        baoLoi(out, std::string(tienTo) + "quá dài (<= " + to_string(maxL) + ")!");
    return false;
}

// Tìm bản ghi DanhMucSach theo mã sách (đã trim); trả về nullptr nếu không có
static DanhMucSach* timDanhMucTheoMaSach(const std::string& maSach){
    std::string ms = loaiBoKhoangTrangDauCuoi(maSach);
    for(int i=0;i<soLuongDauSach;++i){
        if(dsDauSach[i]){
            for(DanhMucSach* s = dsDauSach[i]->dms; s; s = s->next){
                if(s->maSach == ms) return s;
            }
        }
    }
    return nullptr;
}

// =============================================================================
// CHUYỂN ĐỔI CHUỖI THÀNH SỐ (Gộp các hàm chuyển đổi)
// =============================================================================

// Chuyển chuỗi thành số nguyên (hàm tổng quát)
static bool chuyenChuoiThanhSoNguyen(const std::string& chuoi, int& ketQua, bool chiChoPhepSoDuong = false){
    if(chuoi.empty()) return false;
    
    long long dau = 1;
    size_t viTri = 0;
    
    if(chuoi[0] == '-'){
        if(chiChoPhepSoDuong) return false; 
        dau = -1; 
        viTri = 1;
        if(chuoi.size() == 1) return false; 
    }
    
    long long soTichLuy = 0;
    for(; viTri < chuoi.size(); ++viTri){
        if(!laKyTuSo(chuoi[viTri])) return false;
        soTichLuy = soTichLuy * 10 + (chuoi[viTri] - '0');
        if(soTichLuy * dau > INT_MAX || soTichLuy * dau < INT_MIN) return false;
    }
    
    ketQua = int(soTichLuy * dau);
    return true;
}

// Wrapper functions cho dễ sử dụng
static bool chuyenChuoiThanhSoBatKy(const std::string& chuoi, int& ketQua){
    return chuyenChuoiThanhSoNguyen(chuoi, ketQua, false);
}

static bool chuyenChuoiThanhSoDuong(const std::string& chuoi, int& ketQua){
    return chuyenChuoiThanhSoNguyen(chuoi, ketQua, true);
}

// Phân tích trạng thái sách từ chuỗi (0/1/2 hoặc tên trạng thái)
static bool PhanTichTrangThaiSach(const std::string& s, int& out){
    std::string t = loaiBoKhoangTrangDauCuoi(s);
    if(t.empty()) return false;
    int v = -1;
    if(chuyenChuoiThanhSoBatKy(t, v)){
        out = v; return true;
    }
    std::string norm = BoDauVaThuong(t);
    if(norm == "cho muon duoc" || norm == "cho muon duoc (0)" || norm == "0"){ out = 0; return true; }
    if(norm == "dang muon" || norm == "1"){ out = 1; return true; }
    if(norm == "thanh ly" || norm == "2"){ out = 2; return true; }
    return false;
}

static bool phanTichNgay(const std::string& s, int& ngay, int& thang, int& nam){
    // Hỗ trợ: D/M/YY hoặc DD/MM/YYYY; chấp nhận '-' '.' và tự quy về '/'
    int thanhPhan[3] = {0, 0, 0};
    int chiSo = 0;
    std::string phan;

    // Tách chuỗi theo '/'
    for(char c : s){
        if(c=='-' || c=='.') c = '/';
        if(c == '/'){
            if(phan.empty() || chiSo >= 3) return false;
            int v = 0;
            if(!chuyenChuoiThanhSoDuong(phan, v)) return false;
            thanhPhan[chiSo++] = v;
            phan.clear();
        } else {
            if(!laKyTuSo(c)) return false;
            phan.push_back(c);
        }
    }

    // Phải có đúng 2 dấu '/', còn lại là phần thứ 3
    if(phan.empty() || chiSo != 2) return false;
    int v = 0;
    if(!chuyenChuoiThanhSoDuong(phan, v)) return false;
    thanhPhan[chiSo] = v;

    ngay  = thanhPhan[0];
    thang = thanhPhan[1];
    nam   = thanhPhan[2];

    // Chuẩn hóa năm 2 chữ số
    if(nam < 100) nam = (nam <= 30 ? nam + 2000 : nam + 1900);

    // Kiểm tra phạm vi cơ bản
    if(thang < 1 || thang > 12) return false;
    if(ngay  < 1 || ngay  > 31) return false;
    if(nam   < 1900 || nam > 2100) return false;

    // Kiểm tra số ngày hợp lệ theo tháng, có xét năm nhuận
    int soNgayThang[] = {0,31,28,31,30,31,30,31,31,30,31,30,31};
    bool namNhuan = (nam % 400 == 0) || (nam % 4 == 0 && nam % 100 != 0);
    if(namNhuan) soNgayThang[2] = 29;
    if(ngay > soNgayThang[thang]) return false;

    return true;
}

// Chuẩn hóa chuỗi ngày sang định dạng DD/MM/YYYY nếu hợp lệ
bool ChuanHoaNgay(std::string& s, std::ostream& out){
    (void)out; // không dùng tham số out trong hàm này
    s = loaiBoKhoangTrangDauCuoi(s);
    if(s.empty()) return false;
    int d=0,m=0,y=0;
    if(!phanTichNgay(s, d, m, y)) return false;
    char buf[11];
    snprintf(buf, sizeof(buf), "%02d/%02d/%04d", d, m, y);
    s.assign(buf);
    return true;
}

// ========================= HÀM PHỤ TRỢ CÔNG KHAI =========================
// Triển khai các wrapper công khai tương ứng với các tiện ích nội bộ ở trên.

// ============ HÀM XỬ LÝ KHOẢNG TRẮNG TỔNG HỢP ============
std::string CatKhoangTrang(const std::string& s){
    return loaiBoKhoangTrangDauCuoi(s);
}

// Chuẩn hóa khoảng trắng (tái sử dụng laKhoangTrang và catKhoangTrang)
std::string ChuanHoaKhoangTrang(const std::string& s){
    std::string out; out.reserve(s.size());
    bool prevSpace = false;
    for(char c: s){
        // Tái sử dụng hàm laKhoangTrang thay vì liệt kê lại
        char x = laKyTuKhoangTrang(c) ? ' ' : c;
        if(x==' '){
            if(!prevSpace){ out.push_back(' '); prevSpace = true; }
        } else {
            out.push_back(x); prevSpace = false;
        }
    }
    // Tái sử dụng catKhoangTrang để trim thay vì viết lại logic
    return loaiBoKhoangTrangDauCuoi(out);
}

bool ChuyenNgaySangTimeT(const std::string& sNgay, time_t& outTime){
    std::string t = CatKhoangTrang(sNgay);
    if(t.empty()) return false;
    int d=0,m=0,y=0; if(!phanTichNgay(t, d, m, y)) return false;
    tm tg{}; tg.tm_mday=d; tg.tm_mon=m-1; tg.tm_year=y-1900;
    time_t tt = mktime(&tg); if(tt == -1) return false; outTime = tt; return true;
}

std::string ChuanHoaPhai(const std::string& raw){
    std::string loc = chuanHoaPhaiForCompare(raw);
    if(loc == "nam") return "Nam";
    if(loc == "nu") return "Nữ";
    return std::string();
}

void SetISBNBehavior(bool lenientFile, bool warnOnFixFile, bool lenientInput){
    g_lenientFile = lenientFile;
    g_warnOnFixFile = warnOnFixFile;
    g_lenientInput = lenientInput;
}

bool ChuanHoaISBNNhapTay(const std::string& raw, std::string& outISBN, std::ostream& out){
    // Nếu cấu hình nhập tay lenient, cho phép auto-fix check digit; ngược lại dùng bản strict
    if(g_lenientInput){
        // Tái sử dụng lenient; không in cảnh báo khi nhập tay để đỡ ồn
        std::string tmp;
        if(!ChuanHoaISBNFileLenient(raw, tmp, out)) return false;
        outISBN = tmp; return true;
    }
    return ChuanHoaISBNFile(raw, outISBN, out);
}

// ----------------- Tách & tìm kiếm -----------------
bool TachTruong(const std::string& line, char sep, std::string out[], int expected){
    int idx = 0; std::string cur;
    for(char c: line){
        if(c == sep){ if(idx < expected) out[idx++] = cur; cur.clear(); }
        else cur.push_back(c);
    }
    if(idx < expected) out[idx++] = cur;
    return idx == expected;
}

int TachTokenKhoangTrang(const std::string& s, std::string tokens[], int maxTok){
    int n = 0; std::string t;
    for(char c: s){
        if(laKyTuKhoangTrang(c)){ if(!t.empty()){ if(n<maxTok) tokens[n++] = t; t.clear(); } }
        else t.push_back(c);
    }
    if(!t.empty() && n<maxTok) tokens[n++] = t;
    return n;
}

bool ChuaTatCaTuKhoa(const std::string& haystack, const std::string tokens[], int count){
    for(int i=0;i<count;++i){ if(haystack.find(tokens[i]) == std::string::npos) return false; }
    return true;
}

// ----------------- ISBN/mã sách & vị trí -----------------
std::string TachISBNTuMaSach(const std::string& maSach){
    size_t pos = maSach.find('-');
    return (pos == std::string::npos) ? maSach : maSach.substr(0, pos);
}

const char* TenTrangThai(TrangThaiSach tt){
    switch(tt){
        case CHO_MUON_DUOC: return "Cho mượn được";
        case DANG_MUON:     return "Đang mượn";
        case THANH_LY:      return "Thanh lý";
        default:            return "Không rõ";
    }
}

PTRDAUSACH TimDauSachTheoISBN(PTRDAUSACH ds[], int n, const std::string& isbn){
    for(int i=0;i<n;++i){ PTRDAUSACH d = ds[i]; if(d && d->ISBN == isbn) return d; }
    return nullptr;
}

bool ChenNodeDMSVaoDauSach(PTRDAUSACH d, const std::string& maSach, int tt, const std::string& viTri){
    PTRDMS node = new (std::nothrow) DanhMucSach; if(!node) return false;
    node->maSach = maSach;
    node->trangThai = (TrangThaiSach)tt;
    node->viTri = ChuanHoaKhoangTrang(viTri);
    node->next = nullptr;
    if(!d->dms) d->dms = node; else { PTRDMS t = d->dms; while(t->next) t = t->next; t->next = node; }
    return true;
}

void InTongKet(const char* nhan, int ok, int total, int skip){
    if(total > 0){ baoThongTin(std::cout, std::string(nhan) + ": " + std::to_string(ok) + "/" + std::to_string(total) + " (bỏ qua: " + std::to_string(skip) + ")"); }
}

// ----------------- Hiển thị/nhóm cho Đầu sách -----------------
bool DaInTheLoaiTruocDo(PTRDAUSACH ds[], int i){
    PTRDAUSACH p = ds[i]; if(!p) return true;
    for(int k=0; k<i; ++k){ PTRDAUSACH prev = ds[k]; if(prev && prev->theLoai == p->theLoai) return true; }
    return false;
}

void InMotDauSach(PTRDAUSACH s){
    if(!s) return;
    std::cout << "- " << s->tenSach
              << " | ISBN: " << s->ISBN
              << " | Tác giả: " << s->tacGia
              << " | Năm: " << std::to_string(s->namXuatBan)
              << " | Trang: " << std::to_string(s->soTrang) << '\n';
    if(s->dms){
        for(PTRDMS q = s->dms; q; q = q->next){
            std::cout << "    + Mã: " << q->maSach
                      << " | Trạng thái: " << TenTrangThai(q->trangThai)
                      << " | Vị trí: " << (q->viTri.empty() ? "(trống)" : q->viTri)
                      << '\n';
        }
    } else {
        std::cout << "    (Chưa có bản sao/mã sách)\n";
    }
}

bool KhopTieuDeKhongDau(const std::string& titleNorm, const std::string& kwNorm,
                          const std::string tokens[], int tokenCount){
    if(!kwNorm.empty() && titleNorm.find(kwNorm) != std::string::npos) return true;
    return ChuaTatCaTuKhoa(titleNorm, tokens, tokenCount);
}

// ----------------- Nạp dữ liệu từ file -----------------
void NapDanhSachDauSach(const char* path, PTRDAUSACH dsDauSach[], int& soLuongDauSach){
    std::ifstream fin(path);
    if(!fin){ baoCanhBao(std::cout, std::string("Không mở được ") + path); return; }
    // Dùng kiểm tra trùng trong bộ nhớ để tránh lặp, không cần mảng phụ

    std::string line; int lineNo = 0; int bookTotal = 0; int bookOk = 0; int bookSkip = 0;
    while(std::getline(fin, line)){
        ++lineNo;
        if(line.empty()) continue;
        ++bookTotal;
        std::string f[6];
        if(!TachTruong(line, '|', f, 6)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng: " + line)); ++bookSkip; continue;
        }
        int soTrang = 0, nam = 0;
        if(!chuyenChuoiThanhSoBatKy(CatKhoangTrang(f[2]), soTrang) || !chuyenChuoiThanhSoBatKy(CatKhoangTrang(f[4]), nam)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng số: " + line)); ++bookSkip; continue;
        }
        std::string isbnChuan;
        if(!ChuanHoaISBNFile(f[0], isbnChuan, std::cout)) {
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng ISBN, bỏ qua."));
            ++bookSkip; continue;
        }
        // Kiểm tra trùng trong bộ nhớ (đã có) để tránh lặp
        if(TimDauSachTheoISBN(dsDauSach, soLuongDauSach, isbnChuan)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "ISBN trùng (" + isbnChuan + "), bỏ qua."));
            ++bookSkip; continue;
        }

        std::string tenChuan, tgChuan, tlChuan;
        if(!ChuanHoaTenUnicode(f[1], 1, 200, std::cout, tenChuan)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng tên sách, bỏ qua.")); ++bookSkip; continue;
        }
        if(!ChuanHoaTenUnicode(f[3], 1, 150, std::cout, tgChuan)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng tác giả, bỏ qua.")); ++bookSkip; continue;
        }
        if(!ChuanHoaTenUnicode(f[5], 1, 100, std::cout, tlChuan)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Sai định dạng thể loại, bỏ qua.")); ++bookSkip; continue;
        }
        if(!themDauSach(dsDauSach, soLuongDauSach, isbnChuan, tenChuan, soTrang, tgChuan, nam, tlChuan)){
            baoCanhBao(std::cout, thongBaoLoi(lineNo, "Không thể thêm đầu sách, bỏ qua.")); ++bookSkip;
        } else {
            ++bookOk;
        }
    }
    InTongKet("Nạp đầu sách", bookOk, bookTotal, bookSkip);
}

// Hàm kiểm tra mã sách đã được xử lý trong file này chưa
bool KiemTraMaSachDaXuLy(std::string* danhSachDaXuLy, int soLuongDaXuLy, const std::string& maSach) {
    for(int i = 0; i < soLuongDaXuLy; i++) {
        if(danhSachDaXuLy[i] == maSach) {
            return true;
        }
    }
    return false;
}

// Hàm thêm mã sách vào danh sách đã xử lý
// Hàm giải phóng bộ nhớ danh sách mã sách
void GiaiPhongDanhSachMaSach(std::string*& danhSach) {
    if(danhSach) {
        delete[] danhSach;
        danhSach = nullptr;
    }
}

// Hàm giải phóng linked list DanhMucSach của một đầu sách
void GiaiPhongDanhMucSach(PTRDMS& dms) {
    while(dms) {
        PTRDMS current = dms;
        dms = dms->next;
        delete current;
    }
    dms = nullptr;
}

// Hàm giải phóng một đầu sách và toàn bộ danh mục sách của nó
void GiaiPhongDauSach(PTRDAUSACH& dauSach) {
    if(dauSach) {
        // Giải phóng linked list danh mục sách
        GiaiPhongDanhMucSach(dauSach->dms);
        // Giải phóng đầu sách
        delete dauSach;
        dauSach = nullptr;
    }
}

// ----------------- Ghi dữ liệu ra file -----------------
// Phiên bản silent cho backup (không in thông báo)
bool GhiDanhSachDauSachSilent(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach);
bool GhiDanhMucSachSilent(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach);

// Hàm backup an toàn trước khi giải phóng
bool BackupTruocKhiGiaiPhong(PTRDAUSACH dsDauSach[], int soLuongDauSach) {
    if(soLuongDauSach <= 0) return true; // Không có gì để backup
    
    // Tạo backup với timestamp
    time_t now = time(nullptr);
    tm* timeinfo = localtime(&now);
    char timestamp[32];
    strftime(timestamp, sizeof(timestamp), "%Y%m%d_%H%M%S", timeinfo);
    
    std::string backupPath = std::string("data/backup_") + timestamp + "_dausach.txt";
    std::string backupDMSPath = std::string("data/backup_") + timestamp + "_dms.txt";
    
    bool success = true;
    if(!GhiDanhSachDauSachSilent(backupPath.c_str(), dsDauSach, soLuongDauSach)) {
        success = false;
    }
    
    if(!GhiDanhMucSachSilent(backupDMSPath.c_str(), dsDauSach, soLuongDauSach)) {
        success = false;
    }
    
    return success;
}

// Hàm giải phóng toàn bộ danh sách đầu sách
void GiaiPhongToanBoDauSach(PTRDAUSACH dsDauSach[], int& soLuongDauSach) {
    if(soLuongDauSach <= 0) {
        return;
    }
    
    // Tạo backup an toàn trước khi giải phóng (không thông báo)
    BackupTruocKhiGiaiPhong(dsDauSach, soLuongDauSach);
    
    // Giải phóng bộ nhớ
    for(int i = 0; i < soLuongDauSach; i++) {
        if(dsDauSach[i]) {
            GiaiPhongDauSach(dsDauSach[i]);
        }
    }
    soLuongDauSach = 0;
}

bool ThemMaSachDaXuLy(std::string*& danhSachDaXuLy, int& soLuongDaXuLy, int& dungLuongToiDa, const std::string& maSach) {
    // Mở rộng mảng nếu cần
    if(soLuongDaXuLy >= dungLuongToiDa) {
        int dungLuongMoi = (dungLuongToiDa == 0) ? 256 : (dungLuongToiDa * 2);
        std::string* mangMoi = new (std::nothrow) std::string[dungLuongMoi];
        if(!mangMoi) {
            baoCanhBao(std::cout, "Không đủ bộ nhớ để mở rộng danh sách theo dõi mã sách.");
            return false; // Trả về false để báo lỗi
        }
        
        // Sao chép dữ liệu cũ
        for(int i = 0; i < soLuongDaXuLy; i++) {
            mangMoi[i] = danhSachDaXuLy[i];
        }
        
        // Giải phóng bộ nhớ cũ an toàn
        delete[] danhSachDaXuLy;
        danhSachDaXuLy = mangMoi;
        dungLuongToiDa = dungLuongMoi;
    }
    
    danhSachDaXuLy[soLuongDaXuLy++] = maSach;
    return true;
}

void NapDanhMucSach(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach){
    // Kiểm tra điều kiện tiên quyết trước khi cấp phát bộ nhớ
    std::ifstream fdm(path);
    if(!fdm){ 
        baoCanhBao(std::cout, std::string("Không mở được ") + path); 
        return; 
    }
    
    if(soLuongDauSach <= 0){
        baoCanhBao(std::cout, "Chưa có đầu sách trong bộ nhớ, bỏ qua nạp danh mục sách.");
        return;
    }
    
    // Theo dõi mã sách đã xử lý trong file này - sử dụng scope để tự động cleanup
    {
        std::string* danhSachMaSachDaXuLy = nullptr; 
        int soLuongMaSachDaXuLy = 0; 
        int dungLuongToiDa = 0;
        
        // Khởi tạo biến đếm và theo dõi
        std::string line; 
        int soThuTuDong = 0; 
        int tongSoDong = 0; 
        int soLuongThanhCong = 0; 
        int soLuongBoQua = 0; 
        int soLuongCapNhat = 0;
    // Đọc và xử lý từng dòng
    while(std::getline(fdm, line)){
        soThuTuDong++;
        
        // Bỏ qua dòng trống
        if(line.empty()) continue; 
        tongSoDong++;

        // Tách các trường dữ liệu
        std::string cacTruong[3];
        if(!TachTruong(line, '|', cacTruong, 3)){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng: " + line));
            soLuongBoQua++; 
            continue;
        }

        const std::string& maSach = cacTruong[0];
        const std::string& trangThaiStr = cacTruong[1];
        const std::string& viTri = cacTruong[2];
        
        // Kiểm tra định dạng mã sách: <ISBN-13>-<số thứ tự dương>
        size_t viTriGachNgang = maSach.find('-');
        if(viTriGachNgang == std::string::npos){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng mã sách (thiếu '-'), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        
        // Tách phần ISBN và số thứ tự
        std::string phanISBN = maSach.substr(0, viTriGachNgang);
        std::string phanSoThuTu = maSach.substr(viTriGachNgang + 1);
        
        // Kiểm tra ISBN có đúng 13 chữ số không
        if(phanISBN.size() != 13){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng mã sách (ISBN phải 13 chữ số), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        
        // Kiểm tra ISBN có phải toàn số không
        bool laToanSo = true; 
        for(char kyTu : phanISBN){ 
            if(kyTu < '0' || kyTu > '9'){ 
                laToanSo = false; 
                break; 
            } 
        }
        if(!laToanSo){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng mã sách (ISBN không phải số), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        
        // Kiểm tra số thứ tự
        int soThuTu = 0; 
        if(phanSoThuTu.empty() || !chuyenChuoiThanhSoBatKy(CatKhoangTrang(phanSoThuTu), soThuTu) || soThuTu <= 0){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng mã sách (số thứ tự > 0), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        
        // Kiểm tra trạng thái sách
        int trangThai = 0;
        if(!PhanTichTrangThaiSach(trangThaiStr, trangThai)){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Sai định dạng trạng thái, bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        if(trangThai < 0 || trangThai > 2){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Trạng thái ngoài phạm vi (0-2), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }

        std::string isbn = phanISBN;
        // Tìm đầu sách theo ISBN
        PTRDAUSACH dauSach = TimDauSachTheoISBN(dsDauSach, soLuongDauSach, isbn);
        if(!dauSach){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "ISBN không thuộc danh sách đầu sách đã nạp (" + isbn + "), bỏ qua."));
            soLuongBoQua++; 
            continue;
        }

        // Kiểm tra xem mã sách đã tồn tại trong bộ nhớ chưa
        PTRDMS sachDaTonTai = timDanhMucTheoMaSach(maSach);
        if(sachDaTonTai){
            // Cập nhật thông tin sách đã có
            sachDaTonTai->trangThai = (TrangThaiSach)trangThai;
            sachDaTonTai->viTri = ChuanHoaKhoangTrang(viTri);
            soLuongCapNhat++; 
            soLuongThanhCong++;
            continue;
        }

        // Kiểm tra trùng mã sách trong file này
        if(KiemTraMaSachDaXuLy(danhSachMaSachDaXuLy, soLuongMaSachDaXuLy, maSach)){
            // Tìm và cập nhật bản ghi đã được thêm trước đó trong file
            PTRDMS sachTrongFile = timDanhMucTheoMaSach(maSach);
            if(sachTrongFile){
                sachTrongFile->trangThai = (TrangThaiSach)trangThai;
                sachTrongFile->viTri = ChuanHoaKhoangTrang(viTri);
                soLuongCapNhat++; 
                soLuongThanhCong++;
                continue;
            } else {
                // Trường hợp bất thường - mã đã được xử lý nhưng không tìm thấy
                baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Trùng mã sách trong file (" + maSach + "), bỏ qua."));
                soLuongBoQua++; 
                continue;
            }
        }

        // Thêm sách mới vào danh mục
        if(!ChenNodeDMSVaoDauSach(dauSach, maSach, trangThai, viTri)){
            baoCanhBao(std::cout, thongBaoLoiDMS(soThuTuDong, "Không đủ bộ nhớ để thêm DMS, bỏ qua."));
            soLuongBoQua++; 
            continue;
        }
        
        // Đánh dấu mã sách đã được xử lý
        if(!ThemMaSachDaXuLy(danhSachMaSachDaXuLy, soLuongMaSachDaXuLy, dungLuongToiDa, maSach)) {
            // Nếu không thể thêm vào danh sách theo dõi, vẫn coi như thành công
            // vì sách đã được thêm vào hệ thống, chỉ là không theo dõi được trùng lặp
        }
        soLuongThanhCong++;
    }
    
        // In tổng kết
        InTongKet("Nạp bản sao (DMS)", soLuongThanhCong, tongSoDong, soLuongBoQua);
        if(soLuongCapNhat > 0) {
            baoThongTin(std::cout, std::string("(Trong đó cập nhật: ") + std::to_string(soLuongCapNhat) + ")");
        }
        
        // Giải phóng bộ nhớ an toàn
        GiaiPhongDanhSachMaSach(danhSachMaSachDaXuLy);
    } // Kết thúc scope - đảm bảo tất cả biến local được hủy
}

// ----------------- Ghi dữ liệu ra file -----------------
bool GhiDanhSachDauSach(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach){
    std::ofstream fout(path, std::ios::trunc);
    if(!fout){ baoLoi(std::cout, std::string("Không mở được ") + path + " để ghi!"); return false; }
    int wrote = 0;
    for(int i=0;i<soLuongDauSach;++i){ PTRDAUSACH d = dsDauSach[i]; if(!d) continue;
        fout << d->ISBN << '|' << d->tenSach << '|' << d->soTrang << '|' << d->tacGia << '|' << d->namXuatBan << '|' << d->theLoai << "\n";
        ++wrote;
    }
    return true;
}

// Phiên bản silent cho backup
bool GhiDanhSachDauSachSilent(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach){
    std::ofstream fout(path, std::ios::trunc);
    if(!fout) return false;
    for(int i=0;i<soLuongDauSach;++i){ PTRDAUSACH d = dsDauSach[i]; if(!d) continue;
        fout << d->ISBN << '|' << d->tenSach << '|' << d->soTrang << '|' << d->tacGia << '|' << d->namXuatBan << '|' << d->theLoai << "\n";
    }
    return true;
}

bool GhiDanhMucSach(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach){
    std::ofstream fdm(path, std::ios::trunc);
    if(!fdm){ baoLoi(std::cout, std::string("Không mở được ") + path + " để ghi!"); return false; }
    int wrote = 0;
    for(int i=0;i<soLuongDauSach;++i){ PTRDAUSACH d = dsDauSach[i]; if(!d) continue;
        for(PTRDMS q = d->dms; q; q = q->next){ fdm << q->maSach << '|' << (int)q->trangThai << '|' << q->viTri << "\n"; ++wrote; }
    }
    return true;
}

// Phiên bản silent cho backup
bool GhiDanhMucSachSilent(const char* path, PTRDAUSACH dsDauSach[], int soLuongDauSach){
    std::ofstream fdm(path, std::ios::trunc);
    if(!fdm) return false;
    for(int i=0;i<soLuongDauSach;++i){ PTRDAUSACH d = dsDauSach[i]; if(!d) continue;
        for(PTRDMS q = d->dms; q; q = q->next){ fdm << q->maSach << '|' << (int)q->trangThai << '|' << q->viTri << "\n"; }
    }
    return true;
}


// Chuẩn hóa tên Unicode không tương tác: lọc + title-case + kiểm tra độ dài
bool ChuanHoaTenUnicode(const std::string& dauVao, size_t minLength, size_t maxLength,
                        std::ostream& out, std::string& ketQua){
    if(dauVao.empty()){ baoLoi(out, "Không được để trống!"); return false; }
    if(laChuoiRongHoacChiKhoangTrang(dauVao)){ baoLoi(out, "Chỉ khoảng trắng!"); return false; }
    std::string loc = locChuCaiUnicodeKhoang1(dauVao);
    std::string chuan = tieuDeHoaTiengViet(loc);
    if(chuan.empty()){ baoLoi(out, "Sau lọc rỗng!"); return false; }
    if(!hopLeTheoDoDai(chuan, minLength, maxLength, out, true)) return false;
    ketQua = chuan; return true;
}

// ========================= NHẬP LIỆU TỪ NGƯỜI DÙNG =========================

// Nhập tên với nhãn tuỳ chỉnh
std::string NhapTenNhan(const char* nhan, size_t minLen, size_t maxLen, std::istream& in, std::ostream& out){
    std::string goc; int soLanThu = 0;
    while(soLanThu < SO_LAN_THU_TOI_DA){
        out << "Nhập " << (nhan?nhan:"tên") << " (" << minLen << "-" << maxLen << " ký tự): ";
        std::getline(in, goc);
        
        // Kiểm tra EOF hoặc lỗi stream
        if(in.eof() || in.fail()) {
            throw std::invalid_argument("Lỗi: Kết thúc dữ liệu đầu vào!");
        }
        
        std::string chuan;
        if(ChuanHoaTenUnicode(goc, minLen, maxLen, out, chuan)) return chuan;
        ++soLanThu; thongBaoSoLanThuConLai(soLanThu, out);
    }
    throw std::invalid_argument("Lỗi: Quá số lần nhập sai cho phép!");
}

// Nhập số nguyên với nhãn tuỳ chỉnh
int NhapSoNguyenNhan(const char* nhan, int minVal, int maxVal, std::istream& in, std::ostream& out){
    std::string dong; int soLanThu = 0; int giaTri = 0;
    while(soLanThu < SO_LAN_THU_TOI_DA){
        out << "Nhập " << (nhan?nhan:"giá trị") << " (" << minVal << "-" << maxVal << "): ";
        std::getline(in, dong);
        
        // Kiểm tra EOF hoặc lỗi stream
        if(in.eof() || in.fail()) {
            throw std::invalid_argument("Lỗi: Kết thúc dữ liệu đầu vào!");
        }
        
        std::string sauCat = CatKhoangTrang(dong);
        if(!KiemTraChuoiRong(sauCat, (nhan?nhan:"Giá trị"), out)){ ++soLanThu; }
        else if(sauCat.length() > 30){ baoLoi(out, "Quá dài!"); ++soLanThu; }
        else if(!chuyenChuoiThanhSoBatKy(sauCat, giaTri)){ baoLoi(out, "Sai định dạng số!"); ++soLanThu; }
        else {
            if(giaTri < minVal || giaTri > maxVal){ (void)thongBaoLoiNgoaiPhamVi(out, (nhan?nhan:"Giá trị"), minVal, maxVal); ++soLanThu; }
            else return giaTri;
        }
        thongBaoSoLanThuConLai(soLanThu, out);
    }
    throw std::invalid_argument("Lỗi: Quá số lần nhập sai cho phép!");
}

