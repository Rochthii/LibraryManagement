// Kiểm tra chuỗi có rỗng hoặc chỉ có khoảng trắng
bool KiemTraChuoiRong(const string& chuoi, const string& tenTruong, ostream& out){
    if(chuoi.empty()) { baoLoi(out, tenTruong + " không được rỗng!"); return false; }
